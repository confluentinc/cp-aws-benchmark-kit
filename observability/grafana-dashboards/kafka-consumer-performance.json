          "expr": "sum((kafka_consumer_consumer_coordinator_metrics_rebalance_rate_per_hour{job=\"kafka-client-jmx\",namespace=~\"$namespace\",pod=~\"$pod\",client_id=~\"$consumer_client\"} or kafka_consumer_rebalance_rate_per_hour{job=\"kafka-client-jmx\",namespace=~\"$namespace\",pod=~\"$pod\",client_id=~\"$consumer_client\"})) by (client_id)",
          "legendFormat": "{{client_id}} rebalances/hour",
