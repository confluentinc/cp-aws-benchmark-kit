    {
      "id": 20,
      "type": "timeseries",
      "title": "ClusterLink purgatory (delayed operations)",
      "description": "Requests parked waiting on cluster-link-specific conditions. A large, sustained PurgatorySize here is direct evidence of backpressure specifically from mirroring, separate from normal Produce/Fetch purgatory (see the broker tuning dashboard).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 55
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
