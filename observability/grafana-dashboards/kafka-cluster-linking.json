    {
      "id": 14,
      "type": "timeseries",
      "title": "Degraded / unassigned partitions",
      "description": "Degraded partitions aren't mirroring at full speed for the stated reason; unassigned partitions aren't being fetched by any fetcher thread at all -- both directly cap achievable throughput.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 37
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kafka_server_cluster_link_metrics_link_fetcher_degraded_partition_count{job=\"cfk-jmx\",kubernetes_namespace=~\"$namespace\",link_name=~\"$link_name\"}",
          "legendFormat": "{{kubernetes_pod_name}} degraded: {{reason}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kafka_server_cluster_link_metrics_link_fetcher_unassigned_partition_count{job=\"cfk-jmx\",kubernetes_namespace=~\"$namespace\",link_name=~\"$link_name\"}",
          "legendFormat": "{{kubernetes_pod_name}} unassigned",
          "refId": "B"
        }
      ]
    },
