      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kafka_server_delayedoperationpurgatory_value{job=\"cfk-jmx\",kubernetes_namespace=~\"$namespace\",delayedOperation=\"ClusterLink\"}",
          "legendFormat": "{{kubernetes_pod_name}} {{name}}",
          "refId": "A"
        }
