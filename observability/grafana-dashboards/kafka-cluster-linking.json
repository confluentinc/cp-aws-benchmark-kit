        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kafka_server_cluster_link_metrics_link_fetcher_append_time_avg{job=\"cfk-jmx\",kubernetes_namespace=~\"$namespace\",link_name=~\"$link_name\"}",
          "legendFormat": "{{kubernetes_pod_name}} append avg",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kafka_server_cluster_link_metrics_link_fetcher_append_time_max{job=\"cfk-jmx\",kubernetes_namespace=~\"$namespace\",link_name=~\"$link_name\"}",
          "legendFormat": "{{kubernetes_pod_name}} append max",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kafka_server_cluster_link_metrics_link_fetcher_fetch_time_avg{job=\"cfk-jmx\",kubernetes_namespace=~\"$namespace\",link_name=~\"$link_name\"}",
          "legendFormat": "{{kubernetes_pod_name}} fetch avg",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kafka_server_cluster_link_metrics_link_fetcher_fetch_time_max{job=\"cfk-jmx\",kubernetes_namespace=~\"$namespace\",link_name=~\"$link_name\"}",
          "legendFormat": "{{kubernetes_pod_name}} fetch max",
          "refId": "D"
        }
