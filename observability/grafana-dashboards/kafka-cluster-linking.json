    {
      "id": 23,
      "type": "timeseries",
      "title": "Mirror topic & partition counts",
      "description": "Inventory + failure reasons in one place -- a growing failed-mirror-topic count for a specific reason (e.g. UNSUPPORTED_MIRROR_STATE, TRUNCATION_BELOW_HIGH_WATERMARK) points at a config/compatibility problem rather than a throughput problem.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 64
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(kafka_server_cluster_link_metrics_mirror_topic_count{job=\"cfk-jmx\",kubernetes_namespace=~\"$namespace\",link_name=~\"$link_name\"})",
          "legendFormat": "total mirror topics",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(kafka_server_cluster_link_metrics_mirror_partition_count{job=\"cfk-jmx\",kubernetes_namespace=~\"$namespace\",link_name=~\"$link_name\"})",
          "legendFormat": "total mirror partitions",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
