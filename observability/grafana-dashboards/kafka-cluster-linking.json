    {
      "id": 21,
      "type": "timeseries",
      "title": "Mirror replica health",
      "description": "Broker-side replica-manager view of mirror partitions -- BlockedOnMirrorSourcePartitionCount rising means partitions are stalled waiting on the source, independent of the fetcher-level metrics above.",
