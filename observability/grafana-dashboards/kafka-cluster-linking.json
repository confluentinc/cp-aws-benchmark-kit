      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kafka_server_cluster_link_metrics_mirror_topic_lag{job=\"cfk-jmx\",kubernetes_namespace=~\"$namespace\",link_name=~\"$link_name\",topic=~\"$mirror_topic\"}",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Mirror RPO by topic (seconds of data at risk)",
