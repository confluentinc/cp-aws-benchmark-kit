        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kafka_server_cluster_link_fetcher_metrics_outgoing_byte_rate{job=\"cfk-jmx\",kubernetes_namespace=~\"$namespace\",link_name=~\"$link_name\"}",
          "legendFormat": "{{kubernetes_pod_name}} outgoing",
          "refId": "B"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Fetcher append & fetch-call timing",
