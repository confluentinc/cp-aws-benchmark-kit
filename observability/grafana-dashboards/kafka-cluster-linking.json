      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kafka_server_cluster_link_fetcher_metrics_incoming_byte_rate{job=\"cfk-jmx\",kubernetes_namespace=~\"$namespace\",link_name=~\"$link_name\"}",
          "legendFormat": "{{kubernetes_pod_name}} incoming",
          "refId": "A"
