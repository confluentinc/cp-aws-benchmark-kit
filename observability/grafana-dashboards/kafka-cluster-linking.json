    {
      "id": 17,
      "type": "timeseries",
      "title": "Fetch/produce/destination-lag throttle events",
      "description": "Non-zero and sustained means the destination broker (or the configured io.max.bytes.per.second cap) is actively throttling the fetcher -- raise the cap or investigate destination broker load before assuming the network is the ceiling.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 46
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
