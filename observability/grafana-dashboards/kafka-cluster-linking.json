        "h": 8,
        "w": 12,
        "x": 12,
        "y": 55
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kafka_server_replicamanager_value{job=\"cfk-jmx\",kubernetes_namespace=~\"$namespace\",name=~\"UnderReplicatedMirrorPartitions|UnderMinIsrMirrorPartitionCount|BlockedOnMirrorSourcePartitionCount\"}",
          "legendFormat": "{{kubernetes_pod_name}} {{name}}",
