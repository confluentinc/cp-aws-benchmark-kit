    {
      "id": 2,
      "type": "timeseries",
      "title": "Records, requests, and bytes",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum((kafka_producer_producer_metrics_record_send_rate{job=\"kafka-client-jmx\",namespace=~\"$namespace\",pod=~\"$pod\",client_id=~\"$producer_client\"} or kafka_producer_record_send_rate{job=\"kafka-client-jmx\",namespace=~\"$namespace\",pod=~\"$pod\",client_id=~\"$producer_client\"})) by (client_id)",
          "legendFormat": "{{client_id}} records/sec",
