        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum((kafka_producer_producer_metrics_request_rate{job=\"kafka-client-jmx\",namespace=~\"$namespace\",pod=~\"$pod\",client_id=~\"$producer_client\"} or kafka_producer_request_rate{job=\"kafka-client-jmx\",namespace=~\"$namespace\",pod=~\"$pod\",client_id=~\"$producer_client\"})) by (client_id)",
