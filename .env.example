# ============================================================================
# cp-benchmark-kit — environment configuration
# Copy to .env and fill in the blanks. Every script, Terraform module, and
# Kustomize overlay sources these values. The `.env` file is gitignored.
# ============================================================================

# ─── AWS account ───────────────────────────────────────────────────────────
AWS_ACCOUNT_ID=123456789012
AWS_PROFILE=my-profile              # must have EKS admin + Route53 + ELB + EC2 permissions

# ─── Regions and cluster names ─────────────────────────────────────────────
REGION1=us-east-1
REGION2=us-east-2
CLUSTER_NAME_REGION1=cp-east1
CLUSTER_NAME_REGION2=cp-east2
KUBECTL_CONTEXT_REGION1=cp-east1    # name used in your ~/.kube/config
KUBECTL_CONTEXT_REGION2=cp-east2
NAMESPACE_REGION1=cflt-east1        # Confluent components namespace
NAMESPACE_REGION2=cflt-east2

# ─── Networking (TF outputs populate the SUBNETS lines after `make tf-apply-*`) ───
VPC_CIDR_REGION1=10.101.0.0/16
VPC_CIDR_REGION2=10.102.0.0/16
PRIVATE_SUBNETS_REGION1=            # comma-separated subnet IDs (3, one per AZ) — TF populates
PRIVATE_SUBNETS_REGION2=
PUBLIC_SUBNETS_REGION1=
PUBLIC_SUBNETS_REGION2=
# /22 subnets carved out specifically for NLB IP density (per-broker NLBs chew through IPs fast)
NGINX_INGRESS_SUBNETS_REGION1=
NGINX_INGRESS_SUBNETS_REGION2=

# ─── Route53 private hosted zones (TF outputs populate ZONE_ID) ───────────
ROUTE53_ZONE_ID_REGION1=            # TF populates
ROUTE53_ZONE_ID_REGION2=
DOMAIN_REGION1=cl.cp.east1.example.internal
DOMAIN_REGION2=cl.cp.east2.example.internal
# AWS public NLB hosted zones (do not change — these are AWS-managed per-region constants)
NLB_HOSTED_ZONE_REGION1=Z26RNL4JYFTOTI    # us-east-1
NLB_HOSTED_ZONE_REGION2=ZLMOA37VPKANP     # us-east-2

# ─── Cluster sizing ────────────────────────────────────────────────────────
BROKER_COUNT=15                     # Kafka brokers per region
BROKER_INSTANCE=r7g.8xlarge         # 32 vCPU, 256 GiB, Graviton3
BROKER_STORAGE_GB=1024              # EBS gp3 per broker
BROKER_HEAP_GB=32                   # JVM -Xms / -Xmx

CONTROLLER_COUNT=3                  # KRaft controllers per region
CONTROLLER_INSTANCE=t3.medium       # low-footprint; sits on base nodegroup
CONTROLLER_STORAGE_GB=10

OMB_WORKER_COUNT=10                 # OMB benchmark client nodes
OMB_WORKER_INSTANCE=c7gn.8xlarge    # 32 vCPU, 50 Gbps NIC, Graviton3

INGRESS_NODE_COUNT=3                # nginx-ingress-controller nodes (Topology B only)
INGRESS_INSTANCE=c7gn.2xlarge       # 8 vCPU, 50 Gbps, Graviton3

# ─── Software versions ─────────────────────────────────────────────────────
CFK_VERSION=0.1718.99               # Confluent for Kubernetes Helm chart version
CP_VERSION=8.3.1                    # Confluent Platform image tag
EKS_VERSION=1.36
KUBE_PROMETHEUS_STACK_VERSION=65.5.1
NGINX_INGRESS_CHART_VERSION=4.11.3
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.111.0
JMX_EXPORTER_VERSION=0.20.0

# ─── OMB benchmark image ───────────────────────────────────────────────────
# Point at your own ECR after running `make build-omb-image`.
# The upstream OMB image doesn't include our `topicNames` field patch for
# pre-created topics (needed to avoid createTopics timeout on 150+ topic sweeps).
OMB_IMAGE=${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/cp-benchmark/omb:0.3.0-xregion-arm64

# ─── Confluent license (K8s Secret name; apply the Secret manually) ───────
CONFLUENT_LICENSE_SECRET_NAME=confluent-license

# ─── Benchmark defaults ────────────────────────────────────────────────────
BENCHMARK_TOPIC_COUNT=150
BENCHMARK_PARTITIONS_PER_TOPIC=100
BENCHMARK_REPLICATION_FACTOR=3
BENCHMARK_MIN_ISR=2
BENCHMARK_MESSAGE_SIZE_BYTES=1024
BENCHMARK_WARMUP_MINUTES=1
BENCHMARK_TEST_MINUTES=5

# ─── Intelligent Replication (default state) ──────────────────────────────
INTELLIGENT_REPLICATION_ENABLED=true
