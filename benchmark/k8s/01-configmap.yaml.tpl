apiVersion: v1
kind: ConfigMap
metadata:
  name: omb-configs-ir-sweep
  namespace: ${NAMESPACE}
  labels:
    app: omb
data:
  driver-kafka.yaml: |
    name: Kafka
    driverClass: io.openmessaging.benchmark.driver.kafka.KafkaBenchmarkDriver
    replicationFactor: ${BENCHMARK_REPLICATION_FACTOR}
    topicConfig: |
      min.insync.replicas=${BENCHMARK_MIN_ISR}
    commonConfig: |
      bootstrap.servers=${OMB_BOOTSTRAP_SERVERS}
      security.protocol=SSL
      ssl.keystore.location=/mnt/sslcerts/keystore.p12
      ssl.keystore.password=KEYSTORE_PASSWORD_PLACEHOLDER
      ssl.keystore.type=PKCS12
      ssl.truststore.location=/mnt/sslcerts/truststore.p12
      ssl.truststore.password=KEYSTORE_PASSWORD_PLACEHOLDER
      ssl.truststore.type=PKCS12
      ssl.endpoint.identification.algorithm=${OMB_SSL_ENDPOINT_ID_ALGORITHM}
      request.timeout.ms=180000
      default.api.timeout.ms=300000
    producerConfig: |
      acks=all
      linger.ms=1
      batch.size=1048576
      compression.type=zstd
    consumerConfig: |
      auto.offset.reset=earliest
      enable.auto.commit=false
      fetch.max.wait.ms=50

  # Workload YAMLs for each throughput are generated by render-templates.sh and
  # appended to this ConfigMap (see render-templates.sh for the loop). They're
  # NOT inlined here because they depend on BENCHMARK_TOPIC_COUNT,
  # BENCHMARK_PARTITIONS_PER_TOPIC, BENCHMARK_MESSAGE_SIZE_BYTES, etc. from .env.
${__WORKLOAD_ENTRIES__}
